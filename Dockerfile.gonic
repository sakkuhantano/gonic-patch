# ============================================================
# GONIC BUILDER
# ============================================================
FROM golang:1.26-bookworm AS gonic-builder

ARG GONIC_VERSION=v0.22.0

WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pin the source to the requested release tag.
RUN git clone \
    --branch ${GONIC_VERSION} \
    --depth 1 \
    https://github.com/sentriz/gonic.git .

RUN --mount=type=cache,id=gonic-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=gonic-go-build,target=/root/.cache/go-build \
    go mod download

COPY gonic-watch.patch.py /tmp/gonic-watch.patch.py
RUN python3 /tmp/gonic-watch.patch.py

# ------------------------------------------------------------
# Verify the patch invariants before compiling.
# ------------------------------------------------------------
RUN python3 - <<'PY'
from pathlib import Path

src = Path("scanner/scanner.go").read_text()
start = src.find("func (s *Scanner) ExecuteWatch")
end = src.find("\\nfunc watchCallback", start)

if start < 0 or end < 0:
    raise SystemExit("ERROR: ExecuteWatch() not found")

watch = src[start:end]
checks = {
    "no global ScanAndClean": "ScanAndClean(" not in watch,
    "folder batching": "batchRoots" in watch,
    "removed-path tracking": "batchRemoved" in watch,
    "immediate-child enumeration": "os.ReadDir(root)" in watch,
    "child read check": "os.ReadDir(child)" in watch,
    "track cleanup": "cleanWatchTracks" in watch,
    "music-root resolution": "musicDirRelative" in watch,
    "no recursive child walk": "filepath.WalkDir(child" not in watch,
    "removed-path cleanup": "cleanWatchRemovedPath" in watch,
}
failed = [name for name, passed in checks.items() if not passed]
for name, passed in checks.items():
    print(f'{"PASS" if passed else "FAIL"}: {name}')
if failed:
    raise SystemExit("Patch invariant check failed: " + ", ".join(failed))

if 's.db.Where("root_dir = ?", musicDir).Find(&albums)' not in src:
    raise SystemExit("ERROR: removed-path cleanup is not scoped to root_dir")
PY

# Run the full repository test suite and static analysis, not only scanner/db.
RUN --mount=type=cache,id=gonic-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=gonic-go-build,target=/root/.cache/go-build \
    go test ./...

RUN --mount=type=cache,id=gonic-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=gonic-go-build,target=/root/.cache/go-build \
    go vet ./...

RUN --mount=type=cache,id=gonic-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=gonic-go-build,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
    -o /out/gonic ./cmd/gonic

RUN /out/gonic --help >/dev/null

# ============================================================
# RUNTIME IMAGE
# ============================================================
FROM debian:bookworm-slim AS gonic-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    mpv \
    tini \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /music /podcasts /cache /playlists

COPY --from=gonic-builder /out/gonic /usr/local/bin/gonic

ENV TZ="" \
    GONIC_DB_PATH=/data/gonic.db \
    GONIC_LISTEN_ADDR=:80 \
    GONIC_MUSIC_PATH=/music \
    GONIC_PODCAST_PATH=/podcasts \
    GONIC_CACHE_PATH=/cache \
    GONIC_PLAYLISTS_PATH=/playlists

VOLUME ["/data", "/music", "/podcasts", "/cache", "/playlists"]
EXPOSE 80

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["gonic"]
